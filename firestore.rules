rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isInstructor() {
      return isVerifiedUser() && request.auth.token.email == 'ashiqebinrahman@gmail.com';
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    // --- Validation Blueprints (Synchronized verbatim with firebase-blueprint.json) ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid',
        'email',
        'displayName',
        'photoURL',
        'role',
        'createdAt',
        'lastLoginAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'email',
        'displayName',
        'photoURL',
        'role',
        'createdAt',
        'lastLoginAt'
      ])
      && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
      && data.photoURL is string && data.photoURL.size() <= 500
      && data.role is string && (data.role == 'student' || data.role == 'instructor')
      && data.createdAt is timestamp
      && data.lastLoginAt is timestamp;
    }

    function isValidExamAttempt(data) {
      return data.keys().hasAll([
        'attemptId',
        'studentUid',
        'studentName',
        'studentEmail',
        'classId',
        'classTitle',
        'examVersion',
        'attemptNumber',
        'autoGradedCorrect',
        'autoGradedTotal',
        'scorePercent',
        'passed',
        'answersUnlocked',
        'answers',
        'submittedAt',
        'updatedAt',
        'reviewStatus',
        'teacherFeedback',
        'shortAnswerScore',
        'reviewedBy'
      ])
      && data.keys().hasOnly([
        'attemptId',
        'studentUid',
        'studentName',
        'studentEmail',
        'classId',
        'classTitle',
        'examVersion',
        'attemptNumber',
        'autoGradedCorrect',
        'autoGradedTotal',
        'scorePercent',
        'passed',
        'answersUnlocked',
        'answers',
        'submittedAt',
        'updatedAt',
        'reviewStatus',
        'teacherFeedback',
        'shortAnswerScore',
        'reviewedBy'
      ])
      && data.attemptId is string && data.attemptId.size() >= 1 && data.attemptId.size() <= 128 && data.attemptId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 && data.studentUid.matches('^[a-zA-Z0-9_\\-]+$')
      && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
      && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 200
      && data.classId is int && data.classId >= 1 && data.classId <= 20
      && data.classTitle is string && data.classTitle.size() >= 1 && data.classTitle.size() <= 180
      && data.examVersion is string && data.examVersion.size() >= 1 && data.examVersion.size() <= 32
      && data.attemptNumber is int && data.attemptNumber >= 1 && data.attemptNumber <= 500
      && data.autoGradedCorrect is int && data.autoGradedCorrect >= 0 && data.autoGradedCorrect <= 50
      && data.autoGradedTotal is int && data.autoGradedTotal >= 1 && data.autoGradedTotal <= 50
      && data.autoGradedCorrect <= data.autoGradedTotal
      && data.scorePercent is int && data.scorePercent >= 0 && data.scorePercent <= 100
      && data.passed is bool
      && data.answersUnlocked is bool
      && data.answers is list && data.answers.size() >= 1 && data.answers.size() <= 20 && data.answers[0] is map
      && data.submittedAt is timestamp
      && data.updatedAt is timestamp
      && data.reviewStatus is string && (data.reviewStatus == 'pending' || data.reviewStatus == 'reviewed')
      && data.teacherFeedback is string && data.teacherFeedback.size() <= 2000
      && data.shortAnswerScore is int && data.shortAnswerScore >= 0 && data.shortAnswerScore <= 2
      && data.reviewedBy is string && data.reviewedBy.size() <= 200;
    }

    // --- Collection 1: /users/{userId} (PII Isolated) ---
    match /users/{userId} {
      allow get: if isVerifiedUser()
        && isValidId(userId)
        && (isOwner(userId) || isInstructor());

      allow list: if isInstructor();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
        && (isInstructor() ? incoming().role == 'instructor' : incoming().role == 'student')
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && (isOwner(userId) || isInstructor())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt'])
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().lastLoginAt == request.time;

      allow delete: if false;
    }

    // --- Collection 2: /examAttempts/{attemptId} (Immutable Student Snapshots + Instructor Feedback) ---
    match /examAttempts/{attemptId} {
      allow get: if isVerifiedUser()
        && isValidId(attemptId)
        && (isInstructor() || existing().studentUid == request.auth.uid);

      allow list: if isVerifiedUser()
        && (isInstructor() || resource.data.studentUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(attemptId)
        && isValidExamAttempt(incoming())
        && incoming().attemptId == attemptId
        && incoming().studentUid == request.auth.uid
        && incoming().studentEmail == request.auth.token.email
        && incoming().reviewStatus == 'pending'
        && incoming().teacherFeedback == ''
        && incoming().shortAnswerScore == 0
        && incoming().reviewedBy == ''
        && incoming().submittedAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser()
        && isValidId(attemptId)
        && isValidExamAttempt(incoming())
        && isInstructor()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'reviewStatus',
          'teacherFeedback',
          'shortAnswerScore',
          'reviewedBy',
          'updatedAt'
        ])
        && incoming().attemptId == existing().attemptId
        && incoming().studentUid == existing().studentUid
        && incoming().studentName == existing().studentName
        && incoming().studentEmail == existing().studentEmail
        && incoming().classId == existing().classId
        && incoming().classTitle == existing().classTitle
        && incoming().examVersion == existing().examVersion
        && incoming().attemptNumber == existing().attemptNumber
        && incoming().autoGradedCorrect == existing().autoGradedCorrect
        && incoming().autoGradedTotal == existing().autoGradedTotal
        && incoming().scorePercent == existing().scorePercent
        && incoming().passed == existing().passed
        && incoming().answersUnlocked == existing().answersUnlocked
        && incoming().answers == existing().answers
        && incoming().submittedAt == existing().submittedAt
        && incoming().reviewedBy == request.auth.token.email
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }
  }
}
