<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI Backend Master Course — Class 01</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap');
:root{
--bg:#0b1119;--panel:#111d29;--panel2:#172638;--paper:#f4f2e9;--ink:#17232f;
--muted:#9aabba;--teal:#60e0c0;--orange:#ffad70;--blue:#80b6ff;--rose:#ff8585;
--line:rgba(255,255,255,.12);
}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--bg);font-family:'DM Sans',-apple-system,BlinkMacSystemFont,sans-serif;color:#edf4f5}
.deck{height:100dvh;width:100vw;position:relative}
.slide{
position:absolute;inset:0;padding:24px 4.6vw 20px;display:flex;flex-direction:column;
opacity:0;visibility:hidden;transform:translateX(24px) scale(.99);
transition:opacity .26s ease,transform .28s ease,visibility .28s;
background:radial-gradient(ellipse at 85% 8%,rgba(65,130,146,.16),transparent 36%),linear-gradient(130deg,#0b1119,#0d1723 65%,#101c29);
}
.slide.active{opacity:1;visibility:visible;transform:none}
.slide-top,.slide-bottom{display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.course-mark{font:500 10px 'DM Mono',ui-monospace,monospace;letter-spacing:.13em;color:#b6c8d1}
.mark-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--teal);margin-right:9px;box-shadow:0 0 14px var(--teal)}
.slide-meta{display:flex;gap:16px;align-items:center;font:10px 'DM Mono',ui-monospace,monospace;letter-spacing:.1em;color:#8095a5}
.slide-meta b{color:var(--teal);font-weight:500}
.slide-content{width:min(1120px,100%);margin:auto;display:flex;flex-direction:column;justify-content:center;flex:1;min-height:0;padding:8px 0 6px}
.title-block{max-width:880px;margin-bottom:20px}
.eyebrow{font:500 10px 'DM Mono',ui-monospace,monospace;letter-spacing:.18em;color:var(--teal);margin-bottom:8px;text-transform:uppercase}
.title-block h1{font:800 clamp(26px,4.2vw,52px)/1.08 'Manrope','DM Sans',sans-serif;letter-spacing:-.04em;margin:0;color:#f1f5f4}
.title-block p{font-size:clamp(13px,1.35vw,16px);color:#a5b7c1;margin:10px 0 0;max-width:760px;line-height:1.5}
.visual-area{height:min(58vh,500px);min-height:260px;display:flex;flex-direction:column;justify-content:center;align-items:center;position:relative;gap:14px}
.slide-bottom{font:10px 'DM Mono',ui-monospace,monospace;color:#6d8292;letter-spacing:.1em}
/* Teacher cue & chrome */
.teacher-cue{position:absolute;left:4.6vw;bottom:48px;z-index:5}
.cue-toggle{border:1px solid rgba(96,224,192,.42);background:rgba(23,38,56,.9);color:var(--teal);border-radius:7px;padding:7px 12px;font:11px 'DM Mono',ui-monospace,monospace;cursor:pointer;transition:.18s}
.cue-toggle:hover{background:#1a3642}
.cue-text{display:none;position:absolute;left:0;bottom:38px;width:min(460px,86vw);background:var(--paper);color:#182532;border-radius:10px;padding:14px 16px;font-size:13px;line-height:1.55;box-shadow:0 16px 44px #0009;border:1px solid #d7d3c5}
.cue-text b{display:block;font:600 10px 'DM Mono',monospace;letter-spacing:.1em;color:#1b6d62;text-transform:uppercase;margin-bottom:4px}
.cue-text hr{border:none;border-top:1px solid #dedad0;margin:8px 0}
.teacher-cue.open .cue-text{display:block}
.controls{position:fixed;z-index:10;right:4.6vw;bottom:42px;display:flex;align-items:center;gap:8px}
.nav-btn{border:1px solid var(--line);background:#142232;color:#eaf3f2;border-radius:8px;min-width:38px;height:34px;padding:0 10px;font-size:15px;cursor:pointer;transition:.16s}
.nav-btn:hover:not(:disabled){border-color:var(--teal);color:var(--teal)}
.nav-btn:disabled{opacity:.28;cursor:default}
.counter{font:11px 'DM Mono',ui-monospace,monospace;color:#91a4b3;min-width:58px;text-align:center}
.progress{position:fixed;top:0;left:0;right:0;height:3px;background:#ffffff0c;z-index:20}
.progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--teal),var(--blue));transition:width .25s}
.help{position:fixed;top:18px;left:50%;transform:translateX(-50%);z-index:12;font:10px 'DM Mono',ui-monospace,monospace;color:#718696;white-space:nowrap}
.key{border:1px solid #62788a;border-radius:3px;padding:1px 5px;color:#c0d0d6}
/* Shared clean interactive buttons & pills */
.act-bar{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;align-items:center}
.cbtn{
border:1px solid rgba(96,224,192,.45);background:#15343a;color:#c8f7ea;
border-radius:8px;padding:8px 14px;font:11px 'DM Mono',ui-monospace,monospace;
cursor:pointer;transition:.18s;letter-spacing:.03em;
}
.cbtn:hover{background:#1c484e;transform:translateY(-1px)}
.cbtn.active{background:var(--teal);color:#0b171d;border-color:var(--teal);font-weight:700}
.cbtn.ghost{background:#142333;border-color:var(--line);color:#b7c9d4}
.cbtn.ghost:hover{border-color:var(--teal);color:var(--teal)}
.cbtn.orange{background:#34251c;border-color:rgba(255,173,112,.5);color:#ffd0a8}
.cbtn.orange:hover{background:#473022}
.cbtn.rose{background:#381f24;border-color:rgba(255,133,133,.5);color:#ffb3b3}
.status-line{
font-size:12.5px;color:#b8cdd6;background:#132433;border:1px solid var(--line);
border-left:3px solid var(--teal);padding:10px 15px;border-radius:7px;
max-width:860px;width:100%;text-align:center;line-height:1.45;transition:.2s;
}
.status-line.orange{border-left-color:var(--orange);color:#ffe2c9}
.status-line.rose{border-left-color:var(--rose);color:#ffd0d0}
.tool-row{display:flex;flex-wrap:wrap;gap:6px;justify-content:center}
.tool-tag{font:10px 'DM Mono',monospace;padding:4px 9px;border-radius:99px;background:#142433;border:1px solid var(--line);color:#9bb3c2}
/* Slide Grid Overlay */
.grid-overlay{position:fixed;inset:0;z-index:40;background:rgba(8,13,20,.96);display:none;flex-direction:column;padding:24px 4.6vw;overflow-y:auto}
.grid-overlay.open{display:flex}
.grid-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.grid-head h2{margin:0;font:700 20px 'Manrope',sans-serif}
.grid-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}
.gitem{background:#132130;border:1px solid var(--line);border-radius:9px;padding:11px 13px;cursor:pointer;transition:.16s}
.gitem:hover{border-color:var(--teal);transform:translateY(-2px)}
.gitem.cur{border-color:var(--teal);background:#15353a}
.gitem small{display:block;font:9px 'DM Mono',monospace;color:var(--teal);margin-bottom:4px}
.gitem b{font:700 13px 'Manrope',sans-serif;display:block;line-height:1.3}
/* Visual Layouts */
.hero-grid{width:100%;height:100%;display:grid;grid-template-columns:1fr 1.12fr;align-items:center;gap:3vw}
.hero-copy{padding-left:1vw}
.pill{display:inline-block;border:1px solid #60e0c055;color:var(--teal);border-radius:20px;padding:6px 12px;font:10px 'DM Mono',monospace;letter-spacing:.12em}
.hero-kicker{font:11px 'DM Mono',monospace;color:#91a7b6;letter-spacing:.22em;margin-top:22px}
.hero-big{font:800 clamp(40px,5.6vw,70px)/1.0 'Manrope',sans-serif;letter-spacing:-.06em;margin-top:14px}
.hero-big em{font-style:normal;color:var(--teal)}
.hero-sub{max-width:420px;font-size:15px;line-height:1.6;color:#9db0bc;margin-top:18px}
.hero-art{height:100%;min-height:300px;position:relative;display:flex;align-items:center;justify-content:center}
.orbit{position:absolute;border:1px solid #89b7c51c;border-radius:50%;width:430px;height:240px;transform:rotate(-22deg)}
.o2{width:520px;height:310px;transform:rotate(26deg)}
.node{position:absolute;border:1px solid #94afc433;background:linear-gradient(145deg,#1a2c3d,#111b29);box-shadow:0 12px 45px #0005;border-radius:16px;z-index:2}
.phone{left:4%;top:18%;width:190px;height:235px;padding:15px}
.phone>span,.server small,.cloud small{display:block;font:9px 'DM Mono',monospace;color:#8ba0b1;letter-spacing:.15em}
.phone-ui{margin-top:16px;background:#0d1722;border-radius:9px;padding:10px;height:155px}
.phone-ui b{font-size:9px;color:#8299a8}
.bubble{font-size:10px;padding:8px;border-radius:9px;margin-top:10px}
.bubble.user{background:#234b51;color:#aff6dd;margin-left:20px}
.bubble.bot{background:#253346;color:#c8d8e0;margin-right:16px}
.cloud{left:44%;top:36%;width:92px;height:78px;border-radius:22px;text-align:center;padding-top:12px;color:var(--teal);font-size:26px}
.server{right:4%;top:22%;width:155px;height:205px;padding:22px;text-align:center}
.rack{display:grid;gap:8px;margin:14px auto}
.rack i{height:24px;border-radius:5px;background:#20394a;border:1px solid #4f7f90;display:block;position:relative}
.rack i:after{content:'';position:absolute;width:6px;height:6px;background:var(--teal);border-radius:50%;right:9px;top:8px}
.flow-line{position:absolute;width:110px;border-top:2px dashed var(--teal);top:42%;left:30%;transform:rotate(4deg)}
.line-b{top:63%;left:33%;border-color:var(--orange);transform:rotate(-7deg)}
.tag{position:absolute;font:9px 'DM Mono',monospace;letter-spacing:.1em;padding:5px 9px;border-radius:5px;background:#112734;color:var(--teal);z-index:3}
.tag-a{left:28%;top:33%}.tag-b{left:31%;top:68%;color:var(--orange)}
/* Timeline & Ladder */
.timeline{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;width:100%;max-width:960px}
.time-item{min-height:84px;padding:12px 15px;border-radius:9px;background:#162a39;border:1px solid #ffffff1c;display:flex;flex-direction:column;gap:5px}
.time-item b{font:10px 'DM Mono',monospace;color:var(--teal)}
.time-item strong{font:700 15px 'Manrope',sans-serif}
.time-item span{font-size:11px;color:#9cafbb}
.time-item.highlight{border-color:#60e0c088;background:#153637}
.time-item.last{border-color:#ffad7066}
.time-break{grid-column:1/4;text-align:center;color:#ffc08e;font:10px 'DM Mono',monospace;letter-spacing:.16em;padding:3px}
.ladder-wrap{width:100%;max-width:960px;display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.mod-card{background:#142333;border:1px solid var(--line);border-radius:12px;padding:16px;cursor:pointer;transition:.2s;display:flex;flex-direction:column;gap:8px}
.mod-card:hover,.mod-card.active{border-color:var(--teal);background:#15343a;transform:translateY(-2px)}
.mod-card small{font:9px 'DM Mono',monospace;color:var(--teal);letter-spacing:.12em}
.mod-card strong{font:700 16px 'Manrope',sans-serif;line-height:1.25}
.mod-card span{font-size:11.5px;color:#9eb3bf;line-height:1.4}
/* Chat Demo & X-Ray */
.chat-demo{width:min(700px,94%);background:#f5f6f8;border-radius:16px;color:#1d2935;box-shadow:0 24px 65px #0005;overflow:hidden;border:1px solid #dde3e8}
.chat-top{height:44px;border-bottom:1px solid #e2e6ea;display:flex;align-items:center;gap:7px;padding:0 16px;font-size:13px;background:#eef1f4}
.chat-top b{margin-left:8px}.chat-top small{margin-left:auto;color:#788896;font-size:10px}
.dot{height:8px;width:8px;border-radius:50%}.red{background:#f47d73}.yellow{background:#eac45c}.green{background:#66c98b}
.chat-area{padding:20px 26px;display:flex;flex-direction:column;gap:12px;min-height:175px;max-height:210px;overflow-y:auto}
.chat-bubble{max-width:78%;padding:10px 14px;border-radius:12px;font-size:13.5px;line-height:1.45}
.chat-bubble.you{background:#d7f4e9;align-self:flex-end}
.chat-bubble.ai{background:#e9edf1;align-self:flex-start}
.chat-input-bar{padding:12px 16px;border-top:1px solid #e2e6ea;display:flex;gap:8px;background:#fff}
.chat-input-bar input{flex:1;border:1px solid #d2dbe2;border-radius:9px;padding:9px 12px;font-size:13px;outline:none;color:#1c2934}
.chat-input-bar button{background:#184e4b;color:#fff;border:none;border-radius:9px;padding:8px 16px;font:600 12px 'DM Mono',monospace;cursor:pointer}
.xray-box{transition:.2s;border:2px solid transparent;border-radius:10px}
.xray-on .xray-box{border:2px dashed #177b70;background:rgba(96,224,192,.14);cursor:pointer}
.xray-tag{display:none;font:9px 'DM Mono',monospace;color:#115d54;font-weight:700;margin-bottom:4px}
.xray-on .xray-tag{display:block}
/* Two worlds & Single concept */
.two-worlds{display:flex;align-items:center;justify-content:center;gap:18px;width:100%;max-width:860px}
.world{width:270px;min-height:195px;border-radius:15px;padding:22px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;text-align:center;transition:.25s;border:1px solid var(--line)}
.visible-world{background:#183340;border-color:#64b9be55}
.hidden-world{background:#252d3f;border-color:#f7a26e55}
.world.lit{transform:scale(1.04);box-shadow:0 0 28px rgba(96,224,192,.28);border-color:var(--teal)}
.hidden-world.lit{box-shadow:0 0 28px rgba(255,173,112,.28);border-color:var(--orange)}
.world-icon{font-size:44px}.world b{font-size:19px}.world span{color:#aebdc7;font-size:12.5px}
.world small{font:9px 'DM Mono',monospace;letter-spacing:.14em;color:var(--teal)}.hidden-world small{color:var(--orange)}
.corridor{width:190px;text-align:center;position:relative;color:#a1b6c0;font:10px 'DM Mono',monospace}
.dashed{border-top:2px dashed #7f9ba8;margin-bottom:10px}
.parcel{position:absolute;top:-22px;left:4%;background:#16353c;border:1px solid var(--teal);color:var(--teal);padding:5px 9px;border-radius:6px;transition:left .7s ease}
.parcel.mid{left:42%}.parcel.end{left:78%;border-color:var(--orange);color:var(--orange)}
.single-concept{display:flex;align-items:center;justify-content:center;gap:4.5vw;width:100%;max-width:920px}
.single-concept.reverse{flex-direction:row-reverse}
.browser-window{width:410px;background:#f2f4f6;border-radius:13px;box-shadow:0 20px 55px #0006;overflow:hidden;color:#192c38}
.windowbar{height:32px;background:#dae1e6;display:flex;align-items:center;gap:5px;padding:0 12px}
.windowbar i{width:7px;height:7px;background:#f0786e;border-radius:50%}
.windowbar i:nth-child(2){background:#e7c15e}.windowbar i:nth-child(3){background:#60b981}
.windowbar span{margin-left:10px;color:#627380;font:9px 'DM Mono',monospace}
.mini-app{padding:16px 28px 20px}
.mini-nav{font-size:9px;color:#63818d;display:flex;justify-content:space-between;border-bottom:1px solid #dce3e7;padding-bottom:10px}
.mini-app h3{font-size:18px;margin:14px 0 8px}
.mini-field{border:1px solid #d3dce1;padding:9px;border-radius:5px;margin-top:8px;font-size:10px;color:#8a9aa3}
.mini-button{background:#1e6c69;color:white;padding:9px;text-align:center;border-radius:5px;font-size:11px;margin-top:12px;font-weight:700}
.definition-card{width:340px}
.definition-card label{color:var(--teal);font:10px 'DM Mono',monospace;letter-spacing:.16em}
.definition-card strong{display:block;font:700 26px/1.22 'Manrope',sans-serif;margin:12px 0}
.definition-card p{color:#9fb2bf;line-height:1.55;font-size:14px;margin:0 0 12px}
.server-illustration{width:400px;height:250px;position:relative;display:flex;align-items:center;justify-content:center}
.server-box{width:175px;height:200px;border:1px solid #6b94a7;background:linear-gradient(150deg,#223d4e,#111d2a);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:10px;position:relative;box-shadow:0 15px 40px #0005;z-index:1}
.server-box.back{position:absolute;transform:translate(98px,-30px);opacity:.65;z-index:0}
.server-light{width:9px;height:9px;background:var(--teal);border-radius:50%;box-shadow:0 0 14px var(--teal)}
.server-slot{height:22px;border-radius:4px;background:#1c3446;border:1px solid #426275}
.server-box span{font:9px 'DM Mono',monospace;color:#8cabbc;letter-spacing:.12em;margin-top:4px}
/* Role / Comparison / Classifier */
.role-visual{display:flex;flex-direction:column;align-items:center;text-align:center;max-width:720px}
.role-icon{font-size:66px;line-height:1.15;filter:drop-shadow(0 10px 20px #0006)}
.role-label{font:10px 'DM Mono',monospace;letter-spacing:.19em;color:var(--teal);margin-top:10px}
.role-main{font:700 28px 'Manrope',sans-serif;margin-top:8px}
.role-desc{font-size:14.5px;color:#a5b7c1;margin-top:6px}
.role-example{border:1px solid #ffffff20;background:#152434;border-radius:10px;padding:12px 20px;margin-top:16px;display:flex;gap:16px;align-items:center}
.role-example span{color:#7fa0ad;font:9px 'DM Mono',monospace;letter-spacing:.1em}
.role-example b{font-size:12.5px}
.quiz-stack{width:100%;max-width:860px;display:grid;gap:10px}
.qrow{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 18px;border-radius:10px;background:#152434;border:1px solid var(--line);transition:.2s}
.qrow.ok{border-color:var(--teal);background:#143536}
.qrow.bad{border-color:var(--rose);background:#331e24}
.qrow span{font-size:13.5px}
/* Architecture & Animated Flows */
.architecture{display:flex;align-items:center;gap:18px;width:100%;max-width:900px}
.arch-node{width:195px;min-height:168px;padding:16px;border:1px solid #ffffff22;border-radius:16px;background:#172a3a;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;text-align:center;transition:.25s}
.arch-node.lit{border-color:var(--teal);background:#16393c;transform:scale(1.04);box-shadow:0 0 26px rgba(96,224,192,.25)}
.arch-node.lit-o{border-color:var(--orange);background:#332622;transform:scale(1.04);box-shadow:0 0 26px rgba(255,173,112,.25)}
.arch-emoji{font-size:40px}
.arch-node b{font:11px 'DM Mono',monospace;color:var(--teal);letter-spacing:.14em}
.server-node b{color:var(--orange)}
.arch-node small{color:#95a9b8;font-size:11px}
.server-stack{width:56px;display:grid;gap:6px}
.server-stack i{height:14px;border-radius:4px;background:#31495b;border:1px solid #698b9b;position:relative;display:block}
.server-stack i:after{content:'';width:5px;height:5px;border-radius:50%;background:var(--orange);position:absolute;right:7px;top:4px}
.arch-middle{flex:1;display:flex;flex-direction:column;gap:12px}
.arrow-label{font:10px 'DM Mono',monospace;letter-spacing:.12em;text-align:center}
.req-label{color:var(--teal)}.res-label{color:var(--orange)}
.road{height:3px;background:rgba(96,224,192,.35);position:relative;border-radius:4px}
.road:after{content:'▶';position:absolute;right:-2px;top:-9px;color:var(--teal);font-size:13px}
.reverse-road{background:rgba(255,173,112,.35)}
.reverse-road:after{content:'◀';right:auto;left:-2px;color:var(--orange)}
.traveller{position:absolute;width:12px;height:12px;border-radius:50%;background:#d8fff4;top:-4.5px;left:6%;box-shadow:0 0 12px var(--teal);animation:travel 2.8s ease-in-out infinite}
.reverse-traveller{background:#ffe5d2;left:84%;box-shadow:0 0 12px var(--orange);animation:travelBack 2.8s ease-in-out infinite}
@keyframes travel{0%{left:4%}100%{left:90%}}
@keyframes travelBack{0%{left:90%}100%{left:4%}}
.step-dot{position:absolute;width:14px;height:14px;border-radius:50%;top:-5.5px;opacity:0;transition:left .75s ease,opacity .2s}
.step-dot.teal{background:var(--teal);box-shadow:0 0 14px var(--teal)}
.step-dot.orange{background:var(--orange);box-shadow:0 0 14px var(--orange)}
/* Envelope / Internet / HTTP / URL */
.envelope-stage{display:flex;align-items:center;gap:5vw;padding:24px 44px;border-radius:18px;background:#142637;border:1px solid #ffffff20;min-width:min(620px,92%)}
.envelope{font-size:70px;color:var(--teal);display:flex;flex-direction:column;align-items:center}
.envelope span{font:10px 'DM Mono',monospace;letter-spacing:.15em}
.res-stage .envelope{color:var(--orange)}
.envelope-copy .stamp{font:10px 'DM Mono',monospace;letter-spacing:.15em;color:var(--teal)}
.res-stage .stamp{color:var(--orange)}
.envelope-copy strong{display:block;font:700 25px 'Manrope',sans-serif;margin:10px 0}
.envelope-copy small{color:#96aab8;font-size:12.5px}
.internet-map{display:flex;align-items:center;gap:26px;width:100%;max-width:850px;flex-wrap:wrap;justify-content:center}
.device{width:165px;height:150px;border:1px solid #ffffff22;background:#172b3b;border-radius:13px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;font-size:40px}
.device b{font:11px 'DM Mono',monospace;color:#bad0d9}
.web-lines{width:350px;height:150px;position:relative;display:flex;align-items:center;justify-content:center}
.web-lines i{position:absolute;width:100%;border-top:1px dashed #548a96;transform:rotate(14deg)}
