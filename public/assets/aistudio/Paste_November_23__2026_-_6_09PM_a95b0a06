document.getElementById('aiStepTag').textContent = d.tag;
document.getElementById('aiStepTitle').innerHTML = d.title;
document.getElementById('aiStepDesc').textContent = d.desc;
document.getElementById('aiStepCode').textContent = d.code;
document.getElementById('aiNextBtn').textContent = i < 5 ? `▶ Next Step (${i + 2} / 6)` : '↺ Replay From Step 1';
}
function stepAI() { clearInterval(aiTimer); aiTimer = null; document.getElementById('aiAutoBtn').textContent = '⚡ Auto-Play Full AI Flow'; setAI((aiCur + 1) % 6); }
function autoAI() {
if (aiTimer) { clearInterval(aiTimer); aiTimer = null; document.getElementById('aiAutoBtn').textContent = '⚡ Auto-Play Full AI Flow'; return; }
document.getElementById('aiAutoBtn').textContent = '⏸ Stop Auto-Play';
setAI(0);
aiTimer = setInterval(() => {
if (aiCur < 5) setAI(aiCur + 1);
else { clearInterval(aiTimer); aiTimer = null; document.getElementById('aiAutoBtn').textContent = '⚡ Auto-Play Full AI Flow'; }
}, 1900);
}
setAI(0);

/* Slide 42: Recap */
const recapTxt = [
'1. Screen (Frontend): You type a message and press Send on the visible interface.',
'2. Client (Browser / App): Your app acts as the Client starting the conversation.',
'3. Request (HTTP + Method + URL): A labeled Request travels over the internet.',
'4. Server (Backend): Remote computers receive the Request and do the real work.',
'5. Response (200 OK + JSON Body): The Server sends back a Status Code and payload.',
'6. Screen Updated! Your Client displays the finished result right in front of you!'
];
function litRecap(i) {
document.querySelectorAll('#recapRow .recap-node').forEach((n, k) => n.classList.toggle('lit', k <= i));
document.getElementById('recapOut').innerHTML = '<strong>' + recapTxt[i] + '</strong>';
}

/* Slide 43: Exit Answer Toggle */
function toggleExit() {
const el = document.getElementById('exitAns');
el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

showSlide(0);
</script>
