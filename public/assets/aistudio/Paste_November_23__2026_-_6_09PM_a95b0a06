log.innerHTML = '<strong>Step 2 / 4 — Server Does the Work:</strong> The Server receives your Request, checks rules, and prepares the answer.';
btn.textContent = '▶ Next Step (3 / 4)';
}
if (step === 3) {
s.className = 'arch-node server-node lit-o'; d2.style.transition = 'none'; d2.style.left = '88%'; d2.style.opacity = '1';
requestAnimationFrame(() => { d2.style.transition = 'left .75s ease'; d2.style.left = '4%'; });
