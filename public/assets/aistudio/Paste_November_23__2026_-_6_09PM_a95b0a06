<script>
const slides = [...document.querySelectorAll('.slide')];
const total = slides.length;
let current = 0;

// Auto-stamp accurate bottom slide numbers & build Grid
const gridList = document.getElementById('gridList');
slides.forEach((s, i) => {
const numStr = String(i + 1).padStart(2, '0') + ' / ' + String(total).padStart(2, '0');
const el = s.querySelector('.snum');
if (el) el.textContent = numStr;
const h1 = s.querySelector('h1')?.textContent || 'Slide ' + (i + 1);
const eb = s.querySelector('.eyebrow')?.textContent || '';
const item = document.createElement('div');
item.className = 'gitem';
item.innerHTML = `<small>${numStr} · ${eb}</small><b>${h1}</b>`;
item.onclick = () => { showSlide(i); toggleGrid(); };
gridList.appendChild(item);
});

function showSlide(n) {
current = Math.max(0, Math.min(total - 1, n));
slides.forEach((s, i) => s.classList.toggle('active', i === current));
document.querySelectorAll('.gitem').forEach((g, i) => g.classList.toggle('cur', i === current));
document.getElementById('counter').textContent = String(current + 1).padStart(2, '0') + ' / ' + String(total).padStart(2, '0');
document.getElementById('prev').disabled = current === 0;
document.getElementById('next').disabled = current === total - 1;
document.getElementById('progressBar').style.width = ((current + 1) / total * 100) + '%';
document.querySelectorAll('.teacher-cue').forEach(x => x.classList.remove('open'));
}
function toggleCue(btn) { btn.parentElement.classList.toggle('open'); }
function toggleGrid() { document.getElementById('gridOverlay').classList.toggle('open'); }
document.getElementById('prev').onclick = () => showSlide(current - 1);
document.getElementById('next').onclick = () => showSlide(current + 1);
document.addEventListener('keydown', e => {
if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) return;
if (['ArrowRight', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); showSlide(current + 1); }
else if (['ArrowLeft', 'PageUp'].includes(e.key)) { e.preventDefault(); showSlide(current - 1); }
else if (e.key.toLowerCase() === 't') { slides[current].querySelector('.teacher-cue')?.classList.toggle('open'); }
else if (e.key.toLowerCase() === 'g') { toggleGrid(); }
else if (e.key === 'Escape') { document.getElementById('gridOverlay').classList.remove('open'); }
});

