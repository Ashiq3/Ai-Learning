btn.textContent = '▶ Next Step (4 / 4)';
}
if (step === 4) {
c.className = 'arch-node lit';
log.innerHTML = '✅ <strong>Step 4 / 4 — Screen Updates!</strong> Your Client opens the Response and displays the answer right in front of your eyes.';
btn.textContent = '↺ Replay Step 1';
}
}
function stepRT() { clearInterval(rtTimer); applyRT(rtStep >= 4 ? 1 : rtStep + 1); }
function resetRT() { clearInterval(rtTimer); applyRT(0); }
